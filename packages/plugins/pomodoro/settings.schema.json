{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cmacrae/kantan/packages/plugins/pomodoro/settings.schema.json",
  "title": "Kantan pomodoro plugin settings",
  "description": "The 'config.settings' block of a module running kantan-plugin-pomodoro. Every setting is optional.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "default": "{remaining}",
      "description": "Format string for the bar display value. Only {name} substitution is supported."
    },
    "work_duration": {
      "type": "integer",
      "minimum": 1,
      "default": 25,
      "description": "Work session duration in minutes."
    },
    "short_break": {
      "type": "integer",
      "minimum": 1,
      "default": 5,
      "description": "Short break duration in minutes."
    },
    "long_break": {
      "type": "integer",
      "minimum": 1,
      "default": 15,
      "description": "Long break duration in minutes."
    },
    "long_break_interval": {
      "type": "integer",
      "minimum": 1,
      "default": 4,
      "description": "Number of work sessions before a long break."
    },
    "auto_start_breaks": {
      "type": "boolean",
      "default": true,
      "description": "Start a break when a work session ends."
    },
    "auto_start_work": {
      "type": "boolean",
      "default": false,
      "description": "Start work when a break ends."
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Colours of the popup. A key left out keeps its default.",
      "properties": {
        "work": {
          "$ref": "module-config.schema.json#/$defs/Color",
          "description": "The ring during work.",
          "default": "red"
        },
        "break": {
          "$ref": "module-config.schema.json#/$defs/Color",
          "description": "The ring during a break.",
          "default": "green"
        },
        "paused": {
          "$ref": "module-config.schema.json#/$defs/Color",
          "description": "The ring while paused or idle.",
          "default": "gray"
        },
        "track": {
          "$ref": "module-config.schema.json#/$defs/Color",
          "description": "The part of the ring that has emptied. Left out, it is the system's faint track."
        },
        "dot": {
          "$ref": "module-config.schema.json#/$defs/Color",
          "description": "The dot of a session that is done.",
          "default": "red"
        },
        "dot_outline": {
          "$ref": "module-config.schema.json#/$defs/Color",
          "description": "The outline of each session's dot.",
          "default": "gray"
        },
        "button": {
          "$ref": "module-config.schema.json#/$defs/Color",
          "description": "The buttons. Left out, they take the system's accent colour."
        }
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "description": "Icons for each state and action. A key left out keeps its default.",
      "properties": {
        "idle": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Bar icon when idle.",
          "default": "circle-filled"
        },
        "work": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Bar icon during work.",
          "default": "hourglass"
        },
        "short_break": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Bar icon during a short break.",
          "default": "moon-filled"
        },
        "long_break": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Bar icon during a long break.",
          "default": "moon-filled"
        },
        "paused": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Bar icon while paused.",
          "default": "player-pause-filled"
        },
        "start": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Start button in the popup.",
          "default": "player-play-filled"
        },
        "resume": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Resume button in the popup.",
          "default": "player-play-filled"
        },
        "pause": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Pause button in the popup.",
          "default": "player-pause-filled"
        },
        "skip": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Skip button in the popup.",
          "default": "player-track-next-filled"
        },
        "reset": {
          "$ref": "module-config.schema.json#/$defs/Icon",
          "description": "Reset button in the popup.",
          "default": "x"
        }
      }
    }
  }
}
